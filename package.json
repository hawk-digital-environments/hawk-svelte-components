{
  "name": "@hawk-hhg/svelte-components",
  "version": "0.13.0",
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "build": "vite build && npm run build:svelte-components && npm run build:themes && npm run build:custom-elements && publint",
    "build:custom-elements": "VITE_BUILD_TYPE=customElements vite build --config vite.config.custom-elements.ts",
    "build:svelte-components": "svelte-kit sync && svelte-package",
    "build:themes": "npm run build:theme:handson && npm run build:theme:hawk",
    "build:theme:handson": "VITE_THEME=handson vite build --config vite.config.themes.ts && VITE_THEME_RESET=handson vite build --config vite.config.themes.ts",
    "build:theme:hawk": "VITE_THEME=hawk vite build --config vite.config.themes.ts && VITE_THEME_RESET=hawk vite build --config vite.config.themes.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "storybook dev -p $DOCKER_PROJECT_PORT --no-open",
    "dev:ssl": "storybook dev -p $DOCKER_PROJECT_PORT --no-open --https --ssl-cert /etc/ssl/certs/cert.pem --ssl-key /etc/ssl/certs/key.pem",
    "build:storybook": "storybook build"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./custom-elements.js": {
      "types": "./dist/_custom-elements/index.d.ts",
      "require": "./dist/_custom-elements/svelte-components.umd.cjs",
      "default": "./dist/_custom-elements/svelte-components.js"
    },
    "./theme-hawk.css": "./dist/_themes/theme-hawk.css",
    "./theme-hawk-reset.css": "./dist/_themes/theme-hawk-reset.css",
    "./theme-handson.css": "./dist/_themes/theme-handson.css",
    "./theme-handson-reset.css": "./dist/_themes/theme-handson-reset.css"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3",
    "@microsoft/api-extractor": "^7.52.8",
    "@storybook/addon-essentials": "^8.6.7",
    "@storybook/addon-svelte-csf": "^5.0.0-next.0",
    "@storybook/addon-themes": "^8.6.12",
    "@storybook/blocks": "^8.6.7",
    "@storybook/experimental-addon-test": "^8.6.7",
    "@storybook/manager-api": "^8.6.10",
    "@storybook/svelte": "^8.6.7",
    "@storybook/sveltekit": "^8.6.7",
    "@storybook/test": "^8.6.7",
    "@storybook/theming": "^8.6.10",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@types/node": "^22.13.12",
    "@types/temp": "^0.9.4",
    "@vitest/browser": "^3.0.9",
    "@vitest/coverage-v8": "^3.0.9",
    "node-html-parser": "^7.0.1",
    "playwright": "^1.51.1",
    "postcss-modules": "^6.0.1",
    "publint": "^0.3.2",
    "sass": "^1.86.0",
    "storybook": "^8.6.7",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-preprocess": "^6.0.3",
    "svgo": "^3.3.2",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.0.9"
  },
  "keywords": [
    "svelte"
  ],
  "dependencies": {
    "@fontsource/fira-sans": "^5.2.5",
    "@fontsource/montserrat": "^5.2.5",
    "melt": "^0.29.3",
    "runed": "^0.25.0",
    "tabbable": "^6.2.0"
  }
}
