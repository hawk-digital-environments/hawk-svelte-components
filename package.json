{
  "name": "@hawk-hhg/svelte-components",
  "repository": {
    "type": "git",
    "url": "https://github.com/hawk-digital-environments/hawk-svelte-components"
  },
  "homepage": "https://hawk-digital-environments.github.io/hawk-svelte-components/?path=/docs/svelte-components--docs",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "build": "vite build && npm run build:svelte-components && npm run build:themes && npm run build:custom-elements && publint",
    "build:custom-elements": "VITE_BUILD_TYPE=customElements vite build --config vite.config.custom-elements.ts",
    "build:svelte-components": "svelte-kit sync && svelte-package",
    "build:themes": "npm run build:theme:handson && npm run build:theme:hawk",
    "build:theme:handson": "VITE_THEME=handson vite build --config vite.config.themes.ts && VITE_THEME_RESET=handson vite build --config vite.config.themes.ts",
    "build:theme:hawk": "VITE_THEME=hawk vite build --config vite.config.themes.ts && VITE_THEME_RESET=hawk vite build --config vite.config.themes.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "storybook dev -p $DOCKER_PROJECT_PORT --no-open",
    "dev:ssl": "storybook dev -p $DOCKER_PROJECT_PORT --no-open --https --ssl-cert /etc/ssl/certs/cert.pem --ssl-key /etc/ssl/certs/key.pem",
    "build:storybook": "storybook build"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./custom-elements.js": {
      "types": "./dist/_custom-elements/index.d.ts",
      "require": "./dist/_custom-elements/svelte-components.umd.cjs",
      "default": "./dist/_custom-elements/svelte-components.js"
    },
    "./custom-elements-fouc.css": {
        "require": "./dist/_custom-elements/custom-elements-fouc.css",
        "default": "./dist/_custom-elements/custom-elements-fouc.css"
    },
    "./theme-hawk.css": "./dist/_themes/theme-hawk.css",
    "./theme-hawk-reset.css": "./dist/_themes/theme-hawk-reset.css",
    "./theme-handson.css": "./dist/_themes/theme-handson.css",
    "./theme-handson-reset.css": "./dist/_themes/theme-handson-reset.css"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@microsoft/api-extractor": "^7.56.3",
    "@storybook/addon-svelte-csf": "^5.0.11",
    "@storybook/addon-themes": "^10.2.10",
    "@storybook/svelte": "^10.2.10",
    "@storybook/sveltekit": "^10.2.10",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.52.0",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^25.2.3",
    "@types/temp": "^0.9.4",
    "@vitest/browser": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "node-html-parser": "^7.0.2",
    "playwright": "^1.58.2",
    "postcss-modules": "^6.0.1",
    "publint": "^0.3.17",
    "sass": "^1.97.3",
    "storybook": "^10.2.10",
    "svelte": "^5.51.3",
    "svelte-check": "^4.4.0",
    "svelte-preprocess": "^6.0.3",
    "svgo": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "@storybook/addon-docs": "^10.2.10"
  },
  "keywords": [
    "svelte"
  ],
  "dependencies": {
    "@fontsource/fira-sans": "^5.2.7",
    "@fontsource/montserrat": "^5.2.8",
    "melt": "^0.44.0",
    "runed": "^0.37.1",
    "tabbable": "^6.4.0"
  }
}
